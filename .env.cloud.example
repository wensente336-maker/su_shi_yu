# Cloud runtime. Copy to .env.cloud on the Tencent Cloud CVM and chmod 600 it.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://business_app:replace-password@your-postgres-private-endpoint:5432/business_dashboard?sslmode=require
CORS_ORIGINS=https://business.example.com
NEXT_PUBLIC_API_BASE_URL=https://business.example.com

# Production access must be supplied by the WeCom SSO proxy; never use the development fallback.
WECOM_AUTH_PROXY_TOKEN=replace-with-a-long-random-secret

# Activate outbound-only Hermes processing after the cloud URL and agent secret are configured on macmini.
HERMES_AGENT_ENABLED=true
HERMES_AGENT_ID=macmini-hermes-01
HERMES_AGENT_SHARED_SECRET=replace-with-the-same-long-random-secret-as-macmini
HERMES_AGENT_CLOCK_SKEW_SECONDS=300
HERMES_AGENT_LEASE_SECONDS=240
HERMES_AGENT_MAX_ATTEMPTS=3

WECOM_PUSH_ENABLED=true
WECOM_PUSH_WEEKDAY=5
WECOM_PUSH_HOUR=10
WECOM_PUSH_MINUTE=0
WECOM_PUSH_RETRY_MINUTES=15
WECOM_CATCHUP_HOURS=6
WECOM_ALLOW_PRELIMINARY_ANALYSIS=false

# Fill only when the WeCom robot service is intentionally enabled.
WECOM_AIBOT_ENABLED=true
WECOM_AIBOT_BOT_ID=replace-with-bot-id
WECOM_AIBOT_SECRET=replace-with-bot-secret
WECOM_AIBOT_TARGET_USERID=replace-with-target-userid
WECOM_AIBOT_INTERNAL_TOKEN=replace-with-a-second-long-random-secret
