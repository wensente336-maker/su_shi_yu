<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.business-dashboard.hermes-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/yucai/.hermes/profiles/su_shi_yu/business-dashboard/hermes_agent.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/yucai/.hermes/profiles/su_shi_yu/business-dashboard</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/yucai/Library/Logs/business-dashboard-hermes-agent.log</string>
  <key>StandardErrorPath</key><string>/Users/yucai/Library/Logs/business-dashboard-hermes-agent-error.log</string>
</dict>
</plist>
