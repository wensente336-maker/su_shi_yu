POSTGRES_DB=business_dashboard
POSTGRES_USER=business_app
POSTGRES_PASSWORD=change-this-before-deployment
DATABASE_URL=postgresql+psycopg://business_app:change-this-before-deployment@db:5432/business_dashboard
API_PORT=8100
WEB_PORT=3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
ENVIRONMENT=development
DEVELOPMENT_DEFAULT_USER=admin
CORS_ORIGINS=http://localhost:3100,http://192.168.1.77:3100
REPORT_SOURCE_HOST_PATH=/Users/yucai/.hermes/profiles/tang_yu_heng/workspace
REPORT_SOURCE_ROOT=/report-source
AI_PROVIDER=disabled
AI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=仅在 AI_PROVIDER=openai 时配置；不要提交到 Git
HERMES_ANALYSIS_ENABLED=false
HERMES_ANALYSIS_URL=http://host.docker.internal:8120
# HERMES_ANALYSIS_TOKEN=看板与 Hermes 桥接服务间的随机共享令牌；不要提交到 Git
# 云端方案二：设为 true 后，云端不会直连本机 Hermes，而由 macmini Agent 主动领取任务。
HERMES_AGENT_ENABLED=false
HERMES_AGENT_ID=macmini-hermes-01
# HERMES_AGENT_SHARED_SECRET=云端与 macmini Agent 共享的随机密钥；不要提交到 Git
HERMES_AGENT_CLOCK_SKEW_SECONDS=300
HERMES_AGENT_LEASE_SECONDS=240
HERMES_AGENT_MAX_ATTEMPTS=3
# CLOUDBASE_SCHEDULER_TOKEN=CloudBase 定时函数调用 /api/v1/internal/cloudbase/weekly-cycle 的随机密钥；不要提交到 Git
WECOM_PUSH_ENABLED=false
# WECOM_WEBHOOK_URL=启用后填写群机器人 Webhook；不要提交到 Git
WECOM_AIBOT_ENABLED=false
# WECOM_AIBOT_BOT_ID=企业微信智能机器人 Bot ID；不要提交到 Git
# WECOM_AIBOT_SECRET=企业微信智能机器人 Secret；不要提交到 Git
# WECOM_AIBOT_TARGET_USERID=主动推送目标用户 ID；不要提交到 Git
# WECOM_AIBOT_INTERNAL_TOKEN=API 与机器人服务间的随机共享令牌；不要提交到 Git
WECOM_PUSH_WEEKDAY=5
WECOM_PUSH_HOUR=10
WECOM_PUSH_MINUTE=0
WECOM_PUSH_RETRY_MINUTES=15
WECOM_CATCHUP_HOURS=6
WECOM_ALLOW_PRELIMINARY_ANALYSIS=false
